# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml. directConnection skips replica-set discovery, which would
# otherwise look for the member by its in-container address.
MONGO_URL=mongodb://localhost:27018/payguard?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6381/0

HEALTH_CHECK_TIMEOUT_MS=2000
JSON_BODY_LIMIT=100kb
