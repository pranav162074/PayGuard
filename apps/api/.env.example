# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml. directConnection skips replica-set discovery, which would
# otherwise look for the member by its in-container address.
MONGO_URL=mongodb://localhost:27018/payguard?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6381/0

HEALTH_CHECK_TIMEOUT_MS=2000
JSON_BODY_LIMIT=100kb

# Signs dashboard access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Development falls back to a fixed value; production refuses to start without a real one.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API with cookies (the dashboard), comma-separated
CORS_ORIGINS=http://localhost:5173
# Proxies in front of the app (for the real client IP); 0 when nothing is in front
TRUST_PROXY_HOPS=0

API_RATE_LIMIT_PER_MINUTE=100
LOGIN_LIMIT_PER_IP=30
LOGIN_LIMIT_PER_EMAIL=10
SIGNUP_LIMIT_PER_IP=5

# Our processing fee in basis points (200 = 2%)
PLATFORM_FEE_BPS=200

# Razorpay (https://dashboard.razorpay.com > Account & Settings > API Keys). Test keys are free
# and take no real money: use them for test-mode payments. Leave live keys empty until you
# really mean to charge people. Key id and secret go together.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
# Where the hosted checkout (apps/checkout) runs; checkout links point here
CHECKOUT_URL=http://localhost:5174
